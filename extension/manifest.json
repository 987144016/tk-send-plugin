{
  "manifest_version": 3,
  "name": "TK Send Plugin · Gmail Web (standalone)",
  "version": "0.3.5",
  "description": "Standalone Gmail web click-send. v0.3.5: Feishu 发送状态 split 退信 vs 可疑拦截 (inbox_scan classifier); keeps v0.3.4 BCC batch / multi-tab / permit-by-mailbox; auto-update checks public GitHub VERSION.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://accounts.google.com/*",
    "http://127.0.0.1:8767/*",
    "https://raw.githubusercontent.com/987144016/tk-send-plugin/*",
    "https://api.github.com/repos/987144016/tk-send-plugin/*",
    "https://github.com/987144016/tk-send-plugin/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "TK Send Plugin (Gmail Web)"
  }
}
