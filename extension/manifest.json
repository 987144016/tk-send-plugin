{
  "manifest_version": 3,
  "name": "TK Send Plugin · Gmail Web (standalone)",
  "version": "0.3.19",
  "description": "Standalone Gmail web click-send. v0.3.19: team installer, ZIP updater, per-person Feishu tables and reply relay.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://accounts.google.com/*",
    "http://127.0.0.1:8767/*",
    "https://tk-send-reply-relay.987144016.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "TK Send Plugin (Gmail Web)"
  }
}
